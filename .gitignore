__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# Cron çıktıları: kök dizindeki tüm .lst'leri yoksay AMA 4 protokol listesini
# whitelist'le — bunlar 2 saatte bir cron ile yenilenip repoya push edilir
# (bkz. git-autopush.sh). Diğer geçici .lst'ler (working.lst vb.) repoya çıkmaz.
/*.lst
!/http.lst
!/https.lst
!/socks4.lst
!/socks5.lst
STDOUT

# proxyprof reputation state (SQLite + WAL/SHM dosyaları)
*.db
*.db-wal
*.db-shm

# Self-host judge deploy dosyası ve log'u — operatör-spesifik ($LOG_FILE path'i,
# tankado.com deploy ayarı vs.). Public repoya çıkmasın ki fork edenler
# kendi PHP host'larına kendi konfigleriyle deploy etsin.
proxyjudge.php
proxyjudge.log

# --debug FILE çıktısı (geliştirici-lokal probe trace log'u).
debug.log
debug.logs

# Cron pipeline log'u (operatör-lokal; proxyprof tablosu/özet buraya yazılır).
proxyprof.log

# Operatör-lokal autopush script'i (hardcoded path icerir; proxine ile ayni
# yaklasim — public repoya cikmaz, fork edenler kendi cron'unu kurar).
git-autopush.sh
